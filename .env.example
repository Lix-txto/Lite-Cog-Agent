# ==========================================
# LLM Provider Configuration
# ==========================================

LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash


# ==========================================
# Agent Configuration
# ==========================================

AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=15


# ==========================================
# Python Execution Configuration
# ==========================================

PYTHON_EXECUTION_TIMEOUT=30
PYTHON_MAX_OUTPUT_SIZE=10000


# ==========================================
# Storage Configuration
# ==========================================
# Maximum number of rows loaded from a single dataset.
# Increase this value for larger datasets when sufficient memory is available.
DATASET_MAX_ROWS=100000
DATA_DIR=./data
SESSION_DIR=./data/sessions
TEMP_DIR=./data/temp


# ==========================================
# Logging Configuration
# ==========================================

LOG_LEVEL=INFO
LOG_DIR=./logs
